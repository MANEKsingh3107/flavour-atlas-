{
  "name": "flavour-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Flavour Atlas: a flavour-pairing guide for chefs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync": "npm run build && npx cap sync ios",
    "assets": "npx @capacitor/assets generate --ios --iconBackgroundColor '#EEEEE8' --splashBackgroundColor '#EEEEE8' --splashBackgroundColorDark '#111617'",
    "ios": "npm run sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
